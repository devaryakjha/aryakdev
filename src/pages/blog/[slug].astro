---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getAllPosts } from '../../utils/blog';
import { formatDate } from '../../utils/date';
export function getStaticPaths() { return getAllPosts().map(post=>({params:{slug:post.slug},props:{post}})); }
const { post } = Astro.props;
const Content = post.Content;
---
<SiteLayout ogType="article" ogImage={`/blog/${post.slug}/og.png`} description={post.frontmatter.excerpt} title={`${post.frontmatter.title} — Aryakumar Jha`}><article class="reading-page"><header class="reading-header"><a class="back" href="/blog">← All writing</a><div class="reading-meta"><span>Aryakumar Jha</span><time datetime={post.frontmatter.date}>{formatDate(post.frontmatter.date)}</time></div><h1>{post.frontmatter.title}</h1></header><div class="reading-body"><Content /></div><footer class="reading-end"><p>Thanks for reading.</p><a href="mailto:me@aryak.dev">Have a thought? Send me a note ↗</a></footer></article></SiteLayout>
