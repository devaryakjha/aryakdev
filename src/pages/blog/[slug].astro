---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate } from "../../utils/date";
import { getAllPosts, splitTags } from "../../utils/blog";
import { site } from "../../data/site";

export function getStaticPaths() {
  return getAllPosts().map((post) => ({ params: { slug: post.slug } }));
}

const slug = Astro.params.slug as string;
const post = getAllPosts().find((p) => p.slug === slug);

if (!post) {
  return Astro.redirect("/404");
}

const fm = post.frontmatter;
const title = `${fm.title} | ${site.name}`;
const description = fm.excerpt ?? site.description;
const tags = splitTags(fm.tags);
const canonical = `/blog/${slug}`;
const ogImage = `/blog/${slug}/og.png`;
const twitterImage = `/blog/${slug}/twitter.png`;
const posterUrl = fm.posterImage?.url;
const posterBg = fm.posterImage?.bgColor ?? "#0b0d10";
const posterFit = fm.posterImage?.fit ?? "contain";
const posterName = posterUrl?.split("/").pop();
const posterAssets = import.meta.glob("../../assets/blogs/*.{png,jpg,jpeg,webp,avif}", {
  eager: true,
  import: "default",
});
const posterAssetEntry = posterName
  ? Object.entries(posterAssets).find(([path]) => path.endsWith(`/${posterName}`))
  : undefined;
const posterAsset = posterAssetEntry?.[1] ?? null;
const Content = post.Content;
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogType="article"
  ogImage={ogImage}
  twitterImage={twitterImage}
  keywords={tags.length ? tags : undefined}
>
  <div class="blog-layout">
    <aside class="blog-aside">
      <a class="back-link" href="/blog">← Blog</a>
      <h1 class="blog-title">{fm.title}</h1>
      <p class="blog-meta">
        <time datetime={fm.date}>{formatDate(fm.date)}</time>
        {fm.author?.name ? <span>· {fm.author.name}</span> : null}
      </p>
      {tags.length ? (
        <ul class="tag-row">
          {tags.map((t) => (
            <li class="tag">{t}</li>
          ))}
        </ul>
      ) : null}
      <div class="aside-links">
        <a href="/#projects">Projects</a>
        <a href="mailto:me@aryak.dev">Email</a>
      </div>
    </aside>

    <article class="blog-article">
      {posterUrl ? (
        <div class={`poster poster-${posterFit}`} style={`--poster-bg: ${posterBg};`}>
          {posterAsset ? (
            <Image
              src={posterAsset}
              alt={fm.title}
              loading="eager"
              decoding="async"
              widths={[720, 960, 1200, 1440]}
              sizes="(max-width: 900px) 100vw, 70vw"
            />
          ) : (
            <img
              src={posterUrl}
              width={posterFit === "cover" ? 1440 : 600}
              height={posterFit === "cover" ? 900 : 600}
              alt={fm.title}
              loading="eager"
              decoding="async"
            />
          )}
        </div>
      ) : null}

      <div class="prose">
        <Content />
      </div>
    </article>
  </div>
  <script>
    const addCopyButtons = () => {
      const blocks = document.querySelectorAll(".prose pre");
      blocks.forEach((pre) => {
        if (pre.querySelector(".code-copy-btn")) return;
        const code = pre.querySelector("code");
        const button = document.createElement("button");
        button.type = "button";
        button.className = "code-copy-btn";
        button.textContent = "Copy";
        button.addEventListener("click", async () => {
          const text = code?.textContent ?? pre.textContent ?? "";
          try {
            await navigator.clipboard.writeText(text);
            button.textContent = "Copied";
            window.setTimeout(() => {
              button.textContent = "Copy";
            }, 1200);
          } catch {
            button.textContent = "Failed";
            window.setTimeout(() => {
              button.textContent = "Copy";
            }, 1200);
          }
        });
        pre.appendChild(button);
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", addCopyButtons, { once: true });
    } else {
      addCopyButtons();
    }
  </script>
</BaseLayout>
