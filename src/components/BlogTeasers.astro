---
import { getAllPosts } from "../utils/blog";
import { formatDate } from "../utils/date";

const posts = getAllPosts().slice(0, 2);
---

<section id="blog" class="section" data-cv>
  <header class="section-head">
    <h2 class="section-title">Blog</h2>
    <p class="section-subtitle">Notes on building and learning.</p>
  </header>

  <ul class="grid blog-grid">
    {posts.map((post) => (
      <li>
        <a class="card blog-card" href={`/blog/${post.slug}`}>
          <div class="blog-main">
            <h3 class="card-title">
              {post.frontmatter.shortTitle ?? post.frontmatter.title}
            </h3>
            {post.frontmatter.excerpt ? (
              <p class="card-desc">{post.frontmatter.excerpt}</p>
            ) : null}
            <div class="meta-row">
              <time class="meta" datetime={post.frontmatter.date}>
                {formatDate(post.frontmatter.date)}
              </time>
              <span class="card-cta">Read</span>
            </div>
          </div>
        </a>
      </li>
    ))}
  </ul>

  <div class="section-footer">
    <a class="button ghost" href="/blog">All posts</a>
  </div>
</section>
