---
import { site } from "../data/site";
---

<section class="hero">
  <div class="hero-copy">
    <p class="eyebrow">{site.role}</p>
    <h1 class="hero-title">
      Hi, I’m <span class="highlight">{site.name}</span>.
      <br />I build fast, accessible web and mobile products.
    </h1>
    <p class="hero-lede">
      Based in {site.location}. I care about performance, clean UI, and small
      systems that stay simple over time.
    </p>
    <div class="hero-cta">
      <a class="button" href="/#projects">Projects</a>
      <a class="button ghost" href="/blog">Read</a>
      <a class="button ghost" href="mailto:me@aryak.dev">Email</a>
    </div>
  </div>
  <aside class="hero-aside" aria-label="Quick facts">
    <dl class="facts">
      <div class="fact">
        <dt>Based</dt>
        <dd>{site.location}</dd>
      </div>
      <div class="fact">
        <dt>Focus</dt>
        <dd>Flutter · TypeScript · UI engineering</dd>
      </div>
      <div class="fact">
        <dt>Now</dt>
        <dd>
          <a href="/blog">Writing</a> and building small, sharp tools.
        </dd>
      </div>
    </dl>
  </aside>
</section>
