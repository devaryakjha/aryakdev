---
import { site } from "../data/site";
---

<section class="hero">
  <div class="hero-copy">
    <p class="eyebrow">{site.role}</p>
    <h1 class="hero-title">
      Hi, I’m <span class="highlight">{site.name}</span>.
      <br />I build fast, accessible web and mobile products.
    </h1>
    <p class="hero-lede">
      Tech at Zerodha. I build Flutter tooling, CI systems, and fast product
      interfaces.
    </p>
    <div class="hero-cta">
      <a class="button" href="/#projects">Projects</a>
      <a class="button ghost" href="/blog">Read</a>
      <a class="button ghost" href="mailto:me@aryak.dev">Email</a>
    </div>
  </div>
  <aside class="hero-aside" aria-label="Quick facts">
    <dl class="facts">
      <div class="fact">
        <dt>Based</dt>
        <dd>{site.location}</dd>
      </div>
      <div class="fact">
        <dt>Focus</dt>
        <dd>Flutter · CI/CD · Product UI</dd>
      </div>
      <div class="fact">
        <dt>Now</dt>
        <dd>
          <a href="https://zerodha.tech" target="_blank" rel="noopener noreferrer"
            >Tech @ Zerodha</a
          >
          ·
          <a href="https://oore.build" target="_blank" rel="noopener noreferrer"
            >Building Oore CI</a
          >
        </dd>
      </div>
    </dl>
  </aside>
</section>
