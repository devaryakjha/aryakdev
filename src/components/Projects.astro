---
import { projects } from "../data/projects";
---

<section id="projects" class="section" data-cv>
  <header class="section-head">
    <h2 class="section-title">Projects</h2>
    <p class="section-subtitle">A few things I’ve built recently.</p>
  </header>

  <ul class="grid">
    {projects.map((p) => (
      <li>
        <article class="card project-card" style={`--accent: ${p.color};`}>
          <a class="project-main-link" href={p.links.details}>
            <div class="project-meta">
              <h3 class="card-title project-title-row">
                <span>{p.title}</span>
                {p.active ? <span class="project-badge">Active</span> : null}
              </h3>
              <p class="card-desc">{p.description}</p>
            </div>
            <div class="project-media">
              <img
                src={p.image}
                width="630"
                height="630"
                alt={p.title}
                loading="lazy"
                decoding="async"
              />
            </div>
          </a>
          <div class="project-actions">
            <a class="card-cta" href={p.links.details}>Details</a>
            {p.links.github ? (
              <a
                class="card-cta"
                href={p.links.github}
                target="_blank"
                rel="noopener noreferrer"
              >
                GitHub
              </a>
            ) : null}
          </div>
        </article>
      </li>
    ))}
  </ul>
</section>
